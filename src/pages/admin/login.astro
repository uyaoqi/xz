---
export const prerender = false;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>管理平台</title>
  <script is:inline src="https://cdn.tailwindcss.com"></script>
</head>
<body class="flex min-h-screen items-center justify-center bg-[#f7f7f2] px-4 py-8 text-gray-800">
  <main class="w-full max-w-md rounded-2xl bg-white p-7 shadow-[0_8px_28px_rgba(42,58,45,.08)] sm:p-9">
    <div class="mb-8 text-center">
      <a href="/" data-no-swup class="mb-5 inline-flex rounded-lg px-3 py-2 text-sm font-medium text-gray-500 hover:bg-gray-50 hover:text-[#438f69]">← 返回首页</a>
      <h1 class="text-2xl font-bold text-[#4b9b72]">管理后台</h1>
      <p class="mt-1 text-sm text-gray-500">请登录后管理文章</p>
    </div>
    <form id="loginForm" class="space-y-5">
      <div>
        <label for="username" class="mb-1 block text-sm font-medium text-gray-700">用户名</label>
        <input type="text" id="username" autocomplete="username" required class="w-full rounded-lg border border-gray-200 px-4 py-2.5 outline-none focus:border-[#4b9b72] focus:ring-2 focus:ring-[#4b9b72]/20" />
      </div>
      <div>
        <label for="password" class="mb-1 block text-sm font-medium text-gray-700">密码</label>
        <input type="password" id="password" autocomplete="current-password" required class="w-full rounded-lg border border-gray-200 px-4 py-2.5 outline-none focus:border-[#4b9b72] focus:ring-2 focus:ring-[#4b9b72]/20" />
      </div>
      <button type="submit" id="submitBtn" class="w-full rounded-lg bg-[#4b9b72] py-2.5 font-semibold text-white transition hover:bg-[#3e855f] disabled:cursor-wait disabled:opacity-60">登 录</button>
      <div id="errMsg" role="alert" class="hidden whitespace-pre-line text-center text-sm text-red-600"></div>
    </form>
  </main>

  <script>
    const form = document.getElementById('loginForm');
    const errMsg = document.getElementById('errMsg');
    const submitBtn = document.getElementById('submitBtn');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errMsg!.classList.add('hidden');
      submitBtn!.innerText = '正在验证...';

      const username = (document.getElementById('username') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;

      try {
        const res = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });
        const data = await res.json();
        if (res.ok) {
          window.location.href = '/admin/';
        } else {
          errMsg!.innerText = data.error || '登录失败';
          errMsg!.classList.remove('hidden');
        }
      } catch (err) {
        errMsg!.innerText = '网络异常，请重试';
        errMsg!.classList.remove('hidden');
      } finally {
        submitBtn!.innerText = '登 录';
      }
    });
  </script>
</body>
</html>
