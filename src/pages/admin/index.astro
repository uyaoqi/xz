---
export const prerender = false;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>后台</title>
  <script is:inline src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-[#f7f7f2] text-gray-800">
  <div class="mx-auto max-w-6xl px-4 py-5 sm:px-6">
    <nav class="mb-5 flex flex-wrap items-center gap-1 rounded-2xl bg-white p-3 shadow-sm sm:p-4" aria-label="后台导航">
      <a href="/" data-no-swup class="rounded-lg px-3 py-2.5 font-medium text-gray-700 hover:bg-gray-50 hover:text-[#438f69]">首页</a>
      <a href="/admin/" data-no-swup aria-current="page" class="rounded-lg bg-[#4b9b72] px-3 py-2.5 font-medium text-white">管理</a>
      <a href="/articles/" data-no-swup class="rounded-lg px-3 py-2.5 font-medium text-gray-700 hover:bg-gray-50 hover:text-[#438f69]">文章库</a>
      <a href="/admin/edit/" data-no-swup class="rounded-lg px-3 py-2.5 font-medium text-gray-700 hover:bg-gray-50 hover:text-[#438f69]">新增文章</a>
      <a href="/" data-no-swup class="rounded-lg px-3 py-2.5 font-medium text-gray-700 hover:bg-gray-50 hover:text-[#438f69]">预览前台</a>
      <button id="logoutBtn" class="ml-auto rounded-lg px-3 py-2.5 font-medium text-gray-600 hover:bg-red-50 hover:text-red-600">退出</button>
    </nav>

    <header class="mb-5 flex flex-wrap items-center justify-between gap-4 rounded-2xl bg-white p-5 shadow-sm sm:p-6">
      <div>
        <h1 class="text-2xl font-bold text-[#4b9b72]">文章管理</h1>
        <p class="text-sm text-gray-500">在线查看、编写、修改与删除博客文章</p>
      </div>
      <div class="flex items-center gap-3">
        <a href="/admin/edit/" class="rounded-lg bg-[#4b9b72] px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-[#3e855f]">+ 新建文章</a>
      </div>
    </header>

    <div class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm">
      <div class="overflow-x-auto">
      <table class="w-full min-w-[680px] border-collapse text-left">
        <thead>
          <tr class="bg-gray-50 border-b text-xs font-semibold text-gray-500 uppercase tracking-wider">
            <th class="p-4">标题 / 文件名</th>
            <th class="p-4">分类</th>
            <th class="p-4">发布日期</th>
            <th class="p-4">状态</th>
            <th class="p-4 text-right">操作</th>
          </tr>
        </thead>
        <tbody id="postsList" class="divide-y divide-gray-100 text-sm">
          <tr><td colspan="5" class="p-6 text-center text-gray-400">正在载入文章列表...</td></tr>
        </tbody>
      </table>
      </div>
    </div>
    <footer class="py-5 text-center text-sm text-gray-500">博客 / U 17</footer>
  </div>

  <script>
      const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      })[char]!);

      async function loadPosts() {
        const listEl = document.getElementById('postsList');
        try {
          const res = await fetch('/api/admin/posts');
          const posts = await res.json();
          if (!res.ok) {
            listEl!.innerHTML = `<tr><td colspan="5" class="p-6 text-center text-red-500">${escapeHtml(posts.error || '文章列表加载失败')}</td></tr>`;
            return;
          }
          if (!posts || posts.length === 0) {
            listEl!.innerHTML = '<tr><td colspan="5" class="p-6 text-center text-gray-400">暂无文章，点击右上角新建文章吧！</td></tr>';
            return;
          }
          listEl!.innerHTML = posts.map((post: any) => `
            <tr class="transition hover:bg-gray-50">
              <td class="p-4">
                <div class="font-medium text-gray-900">${escapeHtml(post.title)}</div>
                <div class="mt-0.5 text-xs text-gray-400">${escapeHtml(post.slug)}.md</div>
              </td>
              <td class="p-4 text-gray-600"><span class="rounded bg-gray-100 px-2 py-0.5 text-xs">${escapeHtml(post.category)}</span></td>
              <td class="p-4 text-gray-500">${escapeHtml(post.published || '未设定')}</td>
              <td class="p-4">
                <span class="inline-flex items-center rounded px-2 py-0.5 text-xs font-medium ${post.draft ? 'bg-amber-100 text-amber-800' : 'bg-green-100 text-green-800'}">
                  ${post.draft ? '草稿' : '已发布'}
                </span>
              </td>
              <td class="space-x-2 p-4 text-right">
                <a href="/admin/edit/?slug=${encodeURIComponent(post.slug)}" data-no-swup class="font-medium text-[#438f69] hover:text-[#326e4f]">编辑</a>
                <button data-delete-slug="${escapeHtml(post.slug)}" class="ml-2 font-medium text-red-600 hover:text-red-800">删除</button>
              </td>
            </tr>
          `).join('');
        } catch (error) {
          console.error('文章列表加载失败：', error);
          listEl!.innerHTML = '<tr><td colspan="5" class="p-6 text-center text-red-500">文章列表加载失败，请检查网络连接后重试。</td></tr>';
        }
      }

    async function deletePost(slug: string) {
      if (!confirm(`确定要删除文章 "${slug}" 吗？此操作无法撤销。`)) return;
      const res = await fetch(`/api/admin/posts?slug=${encodeURIComponent(slug)}`, { method: 'DELETE' });
      const data = await res.json();
      if (res.ok) {
        alert('删除成功！');
        loadPosts();
      } else {
        alert(data.error || '删除失败');
      }
    }

    document.getElementById('postsList')?.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof HTMLElement && target.dataset.deleteSlug) {
        deletePost(target.dataset.deleteSlug);
      }
    });

    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      await fetch('/api/admin/logout', { method: 'POST' });
      window.location.href = '/admin/login/';
    });

    loadPosts();
  </script>
</body>
</html>